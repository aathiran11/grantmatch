<%- include('partials/head', { title: 'Register' }) %>
<div class="container-narrow">
  <div class="card" style="border-top: 3px solid var(--seal); text-align:center;">
    <svg width="34" height="34" viewBox="0 0 40 40" fill="none" style="color:var(--seal); margin-bottom:8px;">
      <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="20" cy="20" r="13.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M13 20.5L17.5 25L27.5 14.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <h1>Create your account</h1>
    <p class="text-muted small">Join GrantMatch as a citizen, volunteer, or NGO partner.</p>
    <% if (error) { %><div class="alert alert-error" style="text-align:left;"><%= error %></div><% } %>
    <form method="POST" action="/register" style="text-align:left;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label>Full name</label>
        <input type="text" name="name" required>
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" required>
      </div>
      <div class="field">
        <label>Phone</label>
        <input type="text" name="phone">
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" name="password" required minlength="6">
      </div>
      <div class="field">
        <label>I am registering as</label>
        <select name="role" id="roleSelect" onchange="document.getElementById('orgField').style.display = this.value==='NGO' ? 'block' : 'none'">
          <option value="USER">Citizen (seeking schemes)</option>
          <option value="VOLUNTEER">Volunteer (helping verify applications)</option>
          <option value="NGO">NGO partner</option>
        </select>
      </div>
      <div class="field" id="orgField" style="display:none;">
        <label>Organization name</label>
        <input type="text" name="organization_name">
      </div>
      <button class="btn btn-block" type="submit">Create account</button>
    </form>
    <p class="small" style="margin-top:14px;">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>
<%- include('partials/foot') %>
