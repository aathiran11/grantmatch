<%- include('partials/head', { title: 'Log In' }) %>
<div class="container-narrow">
  <div class="card" style="border-top: 3px solid var(--seal); text-align:center;">
    <svg width="34" height="34" viewBox="0 0 40 40" fill="none" style="color:var(--seal); margin-bottom:8px;">
      <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="20" cy="20" r="13.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M13 20.5L17.5 25L27.5 14.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <h1>Welcome back</h1>
    <p class="text-muted small">Log in to continue to GrantMatch.</p>
    <% if (error) { %><div class="alert alert-error" style="text-align:left;"><%= error %></div><% } %>
    <form method="POST" action="/login" style="text-align:left;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" required autofocus>
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>
      <button class="btn btn-block" type="submit">Log in</button>
    </form>
    <p class="small" style="margin-top:14px;">New here? <a href="/register">Create an account</a></p>
  </div>
</div>
<%- include('partials/foot') %>
