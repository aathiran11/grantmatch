<%- include('partials/head', { title: 'Manage Users' }) %>
<div class="container">
  <h1>Manage users</h1>
  <div class="card">
    <table>
      <tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th><th>Actions</th></tr>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.email %></td>
          <td><span class="badge badge-status"><%= u.role %></span></td>
          <td class="small text-muted"><%= fmtDate(u.created_at) %></td>
          <td>
            <form method="POST" action="/admin/users/<%= u.id %>/role" style="display:flex; gap:6px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="role" style="width:auto;">
                <% ['USER','VOLUNTEER','NGO','ADMIN'].forEach(r => { %>
                  <option value="<%= r %>" <%= u.role===r?'selected':'' %>><%= r %></option>
                <% }) %>
              </select>
              <button class="btn btn-small btn-secondary" type="submit">Update</button>
            </form>
            <form method="POST" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Delete this user?')" style="display:inline;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:12px;">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>
</div>
<%- include('partials/foot') %>
